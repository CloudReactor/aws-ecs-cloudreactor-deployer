---
{% set task_name=item %}{# from 'with_items' in the calling task #}

{% set service_instance_count=resolved_task_config.service_instance_count | default(unset_value) %}

{% if resolved_task_config.is_service is defined %}
  {% set is_service=resolved_task_config.is_service %}
{% else %}
  {% if service_instance_count is number %}
    {% set is_service=service_instance_count > 0 %}
  {% else %}
    {% set is_service=false %}
  {% endif %}
{% endif %}

{% set max_concurrency=resolved_task_config.max_concurrency | default(1) %}
{% set max_age_seconds=resolved_task_config.max_age_seconds | default(unset_value) %}
{% set wrapper=resolved_task_config.wrapper | default({}) %}
{% set task_aws=resolved_task_config.aws | default({}) %}
{% set project_env_task_aws=project_env_aws | combine(task_aws, recursive=true) %}
{% set project_env_task_aws_network=project_env_task_aws.network | default({}) %}
{% set task_ecs=resolved_task_config.ecs | default({}) %}
{% set project_env_task_ecs=project_env_ecs | combine(task_ecs, recursive=true) %}
{% set cpu_units=project_env_task_ecs.cpu_units | default(256) %}
{% set memory_mb=project_env_task_ecs.memory_mb | default(512) %}
{% set extra_container_cpu_units=project_env_task_ecs.extra_container_cpu_units | default(0) %}
{% set extra_container_memory_mb=project_env_task_ecs.extra_container_memory_mb | default(0) %}
{% set removed_execution_method_properties = [
  'cpu_units', 'memory_mb', 'extra_container_cpu_units', 'extra_container_memory_mb', 
  'extra_main_container_properties', 'extra_container_definitions',
  'extra_task_definition_properties', 'task_definition_family'
] %}
{% set execution_method_capability_details=project_env_task_ecs | combine({
  'task_definition_arn': task_definition_arn,
  'supported_launch_types': project_env_task_ecs.supported_launch_types | default(['FARGATE']),
  'launch_type': project_env_task_ecs.launch_type | default('FARGATE'),
  'main_container_name': main_container_name,
  'main_container_cpu_units': cpu_units - extra_container_cpu_units,
  'main_container_memory_mb': memory_mb - extra_container_memory_mb,
  'monitor_container_name': monitor_container_name
}, recursive=true) %}
{% set execution_method_capability_detail_items_1=execution_method_capability_details | dict2items
  | rejectattr('key', 'in', removed_execution_method_properties)
  | list %}
{% if execution_method_capability_details.capacity_provider_strategy is defined %}
  {% set execution_method_capability_detail_items=execution_method_capability_detail_items_1 | rejectattr('key', 'equalto', 'launch_type') | list %}
{% else %}
  {% set execution_method_capability_detail_items=execution_method_capability_detail_items_1 %}
{% endif %}
{% set final_execution_method_capability_details=execution_method_capability_detail_items | items2dict %}
{% set resolved_ecs_service_deployment_configuration=resolved_ecs_service.deployment_configuration | default({}) %}
{% set effective_service_instance_count=resolved_task_config.service_instance_count | default(1, true) | int %}
{% set effective_min_service_instance_count=resolved_task_config.min_service_instance_count | default(effective_service_instance_count, true) | int %}
{% set resolved_ecs_service_default_minimum_healthy_percent=(100 * effective_min_service_instance_count / effective_service_instance_count) | round(0, 'floor') | int %}
{% if (resolved_task_config.max_concurrency | default(unset_value, true)) == unset_value %}
  {% set resolved_ecs_service_default_maximum_percent=200 %}
{% else %}
  {% set resolved_ecs_service_default_maximum_percent=max_concurrency * 100 %}
{% endif %}
{% set deployment_configuration_1 = resolved_ecs_service_deployment_configuration | combine({
    'minimum_healthy_percent': resolved_ecs_service_deployment_configuration.minimum_healthy_percent | default(resolved_ecs_service_default_minimum_healthy_percent),
    'maximum_percent': resolved_ecs_service_deployment_configuration.maximum_percent | default(resolved_ecs_service_default_maximum_percent)
  }, recursive=true) %}
{% if resolved_ecs_service_deployment_configuration.deployment_circuit_breaker is defined %}
{% set deployment_configuration_final = deployment_configuration_1 | combine({
    'deployment_circuit_breaker': resolved_ecs_service_deployment_configuration.deployment_circuit_breaker | combine({
      'enable': resolved_ecs_service_deployment_configuration.deployment_circuit_breaker.enable | default(true, true),
      'rollback': resolved_ecs_service_deployment_configuration.deployment_circuit_breaker.rollback | default(true, true)
    }, recursive=true)
  }, recursive=true) %}
{% else %}
  {% set deployment_configuration_final = deployment_configuration_1 %}
{% endif %}

{% set service_settings_1 = resolved_ecs_service | combine({
  'deployment_configuration': deployment_configuration_final
}, recursive=true) %}

{% set ns = namespace(resolved_ecs_service_load_balancers=[]) %}
{% if resolved_ecs_service.load_balancers is defined %}
  {% for load_balancer in resolved_ecs_service.load_balancers %}
    {% set ns.resolved_ecs_service_load_balancers = ns.resolved_ecs_service_load_balancers + [load_balancer | combine({'container_name': load_balancer.container_name | default(main_container_name)}, recursive=true)] %}
  {% endfor %}
{% endif %}
{% if resolved_ecs_service.load_balancers is defined %}
  {% set service_settings_final=service_settings_1 | combine({'load_balancers': ns.resolved_ecs_service_load_balancers}, recursive=true) %}
{% else %}
  {% set service_settings_final=service_settings_1 %}
{% endif %}

{% set task_property_names = [
  'description',
  'enabled',
  'max_manual_start_delay_seconds',
  'max_heartbeat_lateness',
  'schedule',
  'scheduled_instance_count',
  'min_service_instance_count',
  'postponed_failure_before_success_seconds',
  'max_postponed_failure_count',
  'postponed_timeout_before_success_seconds',
  'max_postponed_timeout_count',
  'postponed_missing_execution_before_start_seconds',
  'max_postponed_missing_execution_count',
  'min_missing_execution_delay_seconds',
  'should_clear_failure_alerts_on_success',
  'should_clear_timeout_alerts_on_success',
  'is_scheduling_managed',
  'is_service_managed',
  'default_input_value',
  'input_value_schema',
  'output_value_schema',
  'managed_probability',
  'failure_report_probability',
  'timeout_report_probability',
] %}

{% macro filtered_array_prop_def(arr, prop_name) -%}
  {% if (arr is defined) and (arr != unset_value) %}
    {% set filtered_arr=arr | json_query('[?((@.included == undefined) || (to_string(@.included) == to_string(`true`)) || (to_string(@.included) == `True`))]')  %}
  {% else %}
    {% set filtered_arr = unset_value %}
  {% endif %}

  {% if filtered_arr != unset_value %}
    {% if filtered_arr is none -%}
  "{{- prop_name}}": null
    {% elif filtered_arr[0] is defined -%}
  "{{- prop_name}}":
    {% for element in filtered_arr %}
      {{- caller(element) }}
    {% endfor %}
    {% else %}
  "{{- prop_name}}": []
    {% endif %}
  {% endif %}
{%- endmacro %}

{% macro prop_value(v) -%}
{%- if v is none -%}
null
{%- elif v == inherit_value -%}
__inherit__
{%- elif v is number -%}
{{- v | string }}
{%- elif v is boolean -%}
{{- v | string | lower }}
{%- elif v is mapping -%}
{{- v | to_yaml(width=2147483647) }}
{%- else -%}
"{{- v }}"
{%- endif -%}
{%- endmacro %}

{% macro prop_def(obj, name, prop_name='', default_value=unset_value) -%}
  {%- set v = obj[name] | default(default_value) -%}
  {%- if v != unset_value -%}
    {%- if prop_name == '' -%}
      {%- set prop_name = name %}
    {%- endif -%}
  {{- prop_name }}: {{ prop_value(v) }}
  {%- endif -%}
{%- endmacro %}

{% set subnets=project_env_task_aws_network.subnets | default(unset_value) %}
{% set security_groups=project_env_task_aws_network.security_groups | default(unset_value) %}

# For debugging
# resolved_task_config: {{ resolved_task_config | to_json }}
# Project Env ECS: {{ project_env_ecs | to_json }}
# Task ECS: {{ task_ecs | to_json }}
# Project Env AWS: {{ project_env_aws | to_json }}
# Project Env Task ECS: {{ project_env_task_ecs | to_json }}
# Task AWS: {{ task_aws | to_json }}
# Project Env Task AWS: {{ project_env_task_aws | to_json }}
# wrapper: {{ wrapper | to_json }}
# subnets: {{ subnets | to_json }}
# security groups: {{ security_groups | to_json }}
# End debug

name: "{{cloudreactor_task_name}}"

{% for prop_name in task_property_names %}
{{ prop_def(resolved_task_config, prop_name) }}
{% endfor %}

{% if source_repository_url is defined %}
project_url: "{{source_repository_url}}"
{% endif %}

{% if wrapper.api_heartbeat_interval_seconds is defined %}
{{ prop_def(wrapper, 'api_heartbeat_interval_seconds', prop_name='heartbeat_interval_seconds') }}
{% else %}
heartbeat_interval_seconds: 600
{% endif %}

{% if (resolved_task_config.max_concurrency is defined) and (resolved_task_config.max_concurrency != unset_value) %}
max_concurrency: {% if max_concurrency is number %}{{ max_concurrency }}{% else %}null{% endif %}
{% endif %}

is_service: {{is_service}}

{% if service_instance_count != unset_value %}
service_instance_count: {{service_instance_count}}
{% endif %}

{% if max_age_seconds != unset_value %}
max_age_seconds: {% if is_service %}null{% else %}{{ resolved_task_config.max_age_seconds | default('null') }}{% endif %}
{% endif %}

run_environment:
  name: "{{ resolved_task_config.run_environment | default(run_environment_name) }}"

allocated_cpu_units: {{cpu_units}}
allocated_memory_mb: {{memory_mb}}

execution_method_type: AWS ECS
execution_method_capability_details:
{{ final_execution_method_capability_details | to_yaml(width=2147483647) | indent(2, true) }}

infrastructure_type: AWS
infrastructure_settings:
  network:
    region: "{{aws_region}}"

    {% if subnets is none %}
    subnets: null
    {% elif subnets == inherit_value %}
    subnets: __inherit__    
    {% elif subnets != unset_value %}
    subnets:
    {% for subnet in subnets %}
      - "{{ subnet }}"
    {% endfor %}
    {% endif %}

    {% if security_groups is none %}
    security_groups: null
    {% elif security_groups == inherit_value %}
    security_groups: __inherit__
    {% elif security_groups != unset_value %}
    security_groups:
    {% for security_group in security_groups %}
      - "{{ security_group }}"
    {% endfor %}
    {% endif %}

    {{ prop_def(project_env_task_aws_network, 'assign_public_ip') }}

  {% if project_env_task_aws.log_configuration is defined %}
  logging:
    driver: "{{ project_env_task_aws.log_configuration.logDriver }}"
    options: {{ project_env_task_aws.log_configuration.options | default({}) | to_yaml(width=2147483647) }}
  {% else %}
  logging:
    driver: awslogs
    options:
      {{ prop_def(resolved_aws_awslogs, 'create_group', '', 'true') }}
      group: "{{ awslogs_group }}"
      stream_prefix: "{{ awslogs_stream_prefix }}"
      region: "{{ resolved_aws_awslogs.region | default(aws_region) }}"
  {% endif %}

  {% if (project_env_task_aws.tags is defined) and (project_env_task_aws.tags != unset_value) %}
  tags: {{  project_env_task_aws.tags | to_yaml(width=2147483647) }}
  {% endif %}

{% if is_service and ((resolved_task_config.is_service_managed is not defined) or resolved_task_config.is_service_managed) %}
service_provider_type: "AWS ECS"
service_settings:
{{ service_settings_final | to_yaml(width=2147483647) | indent(2, true) }}
{% endif %}

log_query: "{{ log_query }}"

{% call(notification_profiles) filtered_array_prop_def(resolved_task_config.notification_profiles, 'notification_profiles') %}
  - name: "{{ notification_profile.name }}"
{% endcall %}

{% call(link) filtered_array_prop_def(resolved_task_config.links, 'links') %}
  - name: "{{link.name}}"
    {{ prop_def(link, 'link_url_template') }}
    {{ prop_def(link, 'icon_url') }}
    {{ prop_def(link, 'description') }}
{% endcall %}
